# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NUNCA vai para o Git (está no .gitignore) — é onde ficam os segredos.

# Sua chave da Anthropic (https://console.anthropic.com/ → API Keys). Começa com sk-ant-...
ANTHROPIC_API_KEY=coloque_sua_chave_aqui

# Um código que você inventa. O app precisa enviar o mesmo código para ser aceito.
# Ex.: uma frase aleatória. Troque por algo só seu.
ACCESS_CODE=troque-por-um-codigo-secreto

# Quais origens de navegador podem chamar (deixe * por enquanto; o app Electron não é afetado).
ALLOWED_ORIGIN=*

# Porta local (o Render define isso sozinho em produção; use 3000 no seu PC).
PORT=3000
